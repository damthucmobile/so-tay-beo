rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==============================================================================
    // HELPER FUNCTIONS (CÁC HÀM TIỆN ÍCH KIỂM TRA BẢO MẬT)
    // ==============================================================================

    /** Kiểm tra xem người dùng đã đăng nhập Firebase Auth chưa */
    function isAuthenticated() {
      return request.auth != null;
    }

    /** Kiểm tra xem người dùng hiện tại có đúng là chủ sở hữu qua userId khớp với UID hay không */
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    /** Kiểm tra quyền sở hữu đối với tài liệu đã tồn tại (dựa vào trường userId trong document) */
    function isDocOwner() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    /** Kiểm tra quyền sở hữu đối với tài liệu mới được tạo (dựa vào trường userId được gửi lên) */
    function isNewDocOwner() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // ==============================================================================
    // 1. COLLECTION USERS (HỒ SƠ NGƯỜI DÙNG)
    // ==============================================================================
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Xem gần đây (Recent Views): Người dùng toàn quyền quản lý
      match /recentViews/{viewId} {
        allow read, write: if isOwner(userId);
      }

      // Nhật ký hoạt động (Activity Logs): Chỉ ghi nhận và đọc, không cho sửa/xóa
      match /activityLogs/{logId} {
        allow create, read: if isOwner(userId);
        allow update, delete: if false;
      }
    }

    // ==============================================================================
    // 2. COLLECTION USER_NOTES (GHI CHÚ CỦA NGƯỜI DÙNG)
    // ==============================================================================
    match /user_notes/{noteId} {
      allow create: if isNewDocOwner();
      allow read, update, delete: if isDocOwner();
    }

    // ==============================================================================
    // 3. COLLECTION NOTEBOOKS (SỔ TAY PHÂN LOẠI)
    // ==============================================================================
    match /notebooks/{notebookId} {
      allow create: if isNewDocOwner();
      allow read, update, delete: if isDocOwner();
    }

    // ==============================================================================
    // 4. COLLECTION TAGS (NHÃN GHI CHÚ)
    // ==============================================================================
    match /tags/{tagId} {
      allow create: if isNewDocOwner();
      allow read, update, delete: if isDocOwner();
    }

    // ==============================================================================
    // 5. COLLECTION SETTINGS (CẤU HÌNH NGƯỜI DÙNG)
    // ==============================================================================
    match /settings/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ==============================================================================
    // 6. PHÂN HỆ QUẢN LÝ LỚP HỌC (CLASSES, STUDENTS, SCHEDULES, SESSIONS)
    // ==============================================================================
    match /classes/{classId} {
      allow create: if isNewDocOwner();
      allow read, update, delete: if isDocOwner();
    }

    match /class_students/{studentId} {
      allow create: if isNewDocOwner();
      allow read, update, delete: if isDocOwner();
    }

    match /schedule_patterns/{patternId} {
      allow create: if isNewDocOwner();
      allow read, update, delete: if isDocOwner();
    }

    match /class_sessions/{sessionId} {
      allow create: if isNewDocOwner();
      allow read, update, delete: if isDocOwner();
    }

    // ==============================================================================
    // 7. PHÂN HỆ THU NHẬP & THÙ LAO (TRANSACTIONS / INCOME TRANSACTIONS)
    // ==============================================================================
    match /transactions/{txId} {
      allow create: if isNewDocOwner();
      allow read, update, delete: if isDocOwner();
    }

    match /income_transactions/{txId} {
      allow create: if isNewDocOwner();
      allow read, update, delete: if isDocOwner();
    }

    // ==============================================================================
    // 8. PHÂN HỆ LỊCH TỰ DO & KHÁCH HÀNG (APPOINTMENTS, CUSTOMERS)
    // ==============================================================================
    match /appointments/{appointmentId} {
      allow create: if isNewDocOwner();
      allow read, update, delete: if isDocOwner();
    }

    match /customers/{customerId} {
      allow create: if isNewDocOwner();
      allow read, update, delete: if isDocOwner();
    }

    // ==============================================================================
    // 9. PHÂN HỆ THỜI KHÓA BIỂU NHÀ TRƯỜNG (SCHOOL TIMETABLES)
    // ==============================================================================
    match /school_timetables/{timetableId} {
      allow create: if isNewDocOwner();
      allow read, update, delete: if isDocOwner();
    }

    // ==============================================================================
    // 10. PHÂN HỆ THÔNG BÁO & NHẮC NHỞ (REMINDER SETTINGS, PUSH SUBSCRIPTIONS)
    // ==============================================================================
    match /reminder_settings/{settingId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.get('userId', '') == request.auth.uid ||
        settingId.matches('^' + request.auth.uid + '_.*')
      );
      allow create: if isAuthenticated() && (
        request.resource.data.get('userId', '') == request.auth.uid ||
        settingId.matches('^' + request.auth.uid + '_.*')
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.get('userId', '') == request.auth.uid ||
        settingId.matches('^' + request.auth.uid + '_.*')
      );
    }

    match /push_subscriptions/{subId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.get('userId', '') == request.auth.uid ||
        subId.matches('^' + request.auth.uid + '_.*')
      );
      allow create: if isAuthenticated() && (
        request.resource.data.get('userId', '') == request.auth.uid ||
        subId.matches('^' + request.auth.uid + '_.*')
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.get('userId', '') == request.auth.uid ||
        subId.matches('^' + request.auth.uid + '_.*')
      );
    }

    // ==============================================================================
    // 11. PHÂN HỆ DU LỊCH & NGHỈ DƯỠNG (TRAVEL TRIPS & ALBUMS)
    // ==============================================================================
    match /travel_trips/{tripId} {
      // 1. Quyền đọc (Read):
      // - Người thân xem qua liên kết chia sẻ công khai (không cần đăng nhập nếu isPublicLinkEnabled == true)
      // - Hoặc bất kỳ người dùng nào đã đăng nhập hệ thống
      allow read: if (resource != null && resource.data.get(['shareConfig', 'isPublicLinkEnabled'], false) == true)
        || isAuthenticated();

      // 2. Quyền tạo mới (Create): Người dùng đã đăng nhập
      allow create: if isAuthenticated();

      // 3. Quyền cập nhật (Update): Chủ sở hữu chuyến đi hoặc thành viên
      allow update: if isAuthenticated() && (
        resource == null 
        || !('userId' in resource.data) 
        || resource.data.userId == request.auth.uid
      );

      // 4. Quyền xóa (Delete): Chỉ chủ sở hữu chuyến đi
      allow delete: if isAuthenticated() && (
        resource == null 
        || !('userId' in resource.data) 
        || resource.data.userId == request.auth.uid
      );
    }

    // ==============================================================================
    // 12. PHÂN HỆ DU LỊCH: NHẬT KÝ & ALBUM (TRAVEL JOURNALS)
    // ==============================================================================
    match /travel_journals/{journalId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource == null 
        || !('userId' in resource.data) 
        || resource.data.userId == request.auth.uid
      );
    }

    // ==============================================================================
    // 13. PHÂN HỆ DU LỊCH: NGÂN SÁCH & CHI TIÊU (TRAVEL EXPENSES)
    // ==============================================================================
    match /travel_expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource == null 
        || !('userId' in resource.data) 
        || resource.data.userId == request.auth.uid
      );
    }

    // ==============================================================================
    // 14. PHÂN HỆ DU LỊCH: HÀNH LÝ & CHECKLIST (TRAVEL CHECKLISTS & DOCUMENTS)
    // ==============================================================================
    match /travel_checklists/{itemId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource == null 
        || !('userId' in resource.data) 
        || resource.data.userId == request.auth.uid
      );
    }

    match /travel_documents/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource == null 
        || !('userId' in resource.data) 
        || resource.data.userId == request.auth.uid
      );
    }

    // ==============================================================================
    // 15. PHÂN HỆ QUẢN LÝ CHI TIÊU ĐỜI SỐNG (EXPENSES & EXPENSE_BUDGETS)
    // ==============================================================================
    match /expenses/{expenseId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.get('userId', '') == request.auth.uid
      );
      allow update, delete: if isAuthenticated() && (
        resource == null ||
        resource.data.userId == request.auth.uid
      );
    }

    match /expense_budgets/{budgetId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.get('userId', '') == request.auth.uid ||
        budgetId.matches('^' + request.auth.uid + '_.*')
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        budgetId.matches('^' + request.auth.uid + '_.*')
      );
      allow update, delete: if isAuthenticated() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        budgetId.matches('^' + request.auth.uid + '_.*')
      );
    }

    match /expense_categories/{catId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.get('userId', '') == request.auth.uid
      );
      allow update, delete: if isAuthenticated() && (
        resource == null ||
        resource.data.userId == request.auth.uid
      );
    }

    // ==============================================================================
    // 16. CÁC TÍNH NĂNG MỞ RỘNG (HEALTH, FAMILY, EDUCATION)
    // ==============================================================================
    match /health_metrics/{metricId} {
      allow read, write: if isAuthenticated();
    }

    match /family_events/{eventId} {
      allow read, write: if isAuthenticated();
    }

    match /education_goals/{goalId} {
      allow read, write: if isAuthenticated();
    }

    // ==============================================================================
    // 17. PHÂN HỆ TRỢ LÝ AI (AI CHAT SESSIONS & MESSAGES)
    // ==============================================================================
    match /ai_chat_sessions/{sessionId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.get('userId', '') == request.auth.uid
      );
      allow update, delete: if isAuthenticated() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid
      );
    }

    // ==============================================================================
    // QUY TẮC MẶC ĐỊNH: TỪ CHỐI TẤT CẢ CÁC TRUY CẬP KHÔNG ĐƯỢC ĐỊNH NGHĨA RÕ RÀNG
    // ==============================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
